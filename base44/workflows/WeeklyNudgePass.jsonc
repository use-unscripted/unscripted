{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_nudge_pass",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_pass": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "weeklyNudgePass",
            "args": {
              "dryRun": true
            }
          },
          "then": "check_result",
          "x-base44": {
            "title": "Plan this week's nudges",
            "description": "Reads every student, works out the one thing to ask each of them, and writes the plan to the logs. dryRun true is what keeps it from emailing anybody. Do not change it without reading the block comment at the top of base44/functions/weeklyNudgePass/entry.ts."
          }
        }
      },
      {
        "check_result": {
          "switch": [
            {
              "when": "${ .run_pass.success == true }",
              "then": "end"
            },
            {
              "when": "${ true }",
              "then": "end"
            }
          ],
          "x-base44": {
            "title": "Check result"
          }
        }
      }
    ]
  },
  "description": "Runs every Tuesday morning at 9am Eastern. Works out the one thing to ask each student this week and writes the plan to the logs. It sends no email and writes no records: it calls the function with dryRun true, and the function itself is set to allowlist mode, which permits one address and nobody else. Turning it on takes two separate changes by a person: SEND_MODE in base44/functions/weeklyNudgePass/entry.ts, and dryRun plus a confirm string here. A weekday on purpose, and Tuesday rather than Monday because Monday morning is the fullest inbox of the week.",
  "name": "Weekly Nudge Pass",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * 2",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}
