{
  "name": "ResumeVersion",
  "type": "object",
  "properties": {
    "resume_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "version_number": {
      "type": "number"
    },
    "snapshot": {
      "type": "object"
    },
    "version_note": {
      "type": "string"
    }
  },
  "required": [
    "resume_id",
    "snapshot"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}