{
  "name": "PilotEvent",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "event_name": {
      "type": "string",
      "enum": [
        "signup_completed",
        "onboarding_started",
        "onboarding_completed",
        "paths_generated",
        "all_paths_viewed",
        "path_selected",
        "path_investigated",
        "experiment_generated",
        "experiment_recommended",
        "experiment_card_viewed",
        "experiment_detail_viewed",
        "experiment_selected",
        "pre_expectation_started",
        "pre_expectation_completed",
        "experiment_started",
        "experiment_step_completed",
        "experiment_progress_25",
        "experiment_progress_50",
        "experiment_progress_75",
        "experiment_completed",
        "evidence_started",
        "evidence_completed",
        "post_experiment_completed",
        "mission_guide_opened",
        "mission_completed",
        "outreach_attempted",
        "professional_conversation_completed",
        "proof_submitted",
        "reflection_started",
        "reflection_completed",
        "path_updated",
        "decision_completed",
        "next_experiment_recommended",
        "repeat_path_test_started",
        "final_decision_submitted",
        "cycle_completed",
        "second_cycle_attempted",
        "continuation_interest_recorded",
        "seven_day_return",
        "thirty_day_return",
        "simulation_started",
        "simulation_completed",
        "simulation_abandoned",
        "simulation_second_started"
      ]
    },
    "access_source": {
      "type": "string",
      "enum": [
        "independent_beta",
        "institution_sponsored",
        "internal_admin"
      ]
    },
    "analytics_class": {
      "type": "string",
      "enum": [
        "unclassified",
        "real_beta_user",
        "founder",
        "admin",
        "internal_test",
        "automated_test_agent"
      ]
    },
    "institution_id": {
      "type": "string"
    },
    "cohort_id": {
      "type": "string"
    },
    "cycle_id": {
      "type": "string"
    },
    "path_id": {
      "type": "string"
    },
    "experiment_id": {
      "type": "string"
    },
    "mission_id": {
      "type": "string"
    },
    "cycle_index": {
      "type": "number"
    },
    "step_number": {
      "type": "number"
    },
    "stage": {
      "type": "string"
    },
    "value": {
      "type": "number"
    },
    "dedupe_key": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "event_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}