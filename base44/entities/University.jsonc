{
  "name": "University",
  "type": "object",
  "properties": {
    "canonical_name": {
      "type": "string"
    },
    "approved_domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "logo_url": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    // ── Campus events feed ──
    // Resolved once by the campusEvents function and cached here, so a school is
    // probed a single time ever rather than on every student's page load.
    "match_keys": {
      // Normalized spellings of this school seen in StudentProfile.college free
      // text ("fairfield", "fairfield university", "fairfield u").
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "events_platform": {
      // Which calendar platform won the probe. "none" means all four were
      // tried and none answered — the school is re-probed only after a month.
      "type": "string",
      "enum": [
        "unknown",
        "localist",
        "livewhale",
        "trumba",
        "campuslabs",
        // ical is the most common result of a student-submitted portal link,
        // and wptribe/drupal are adapters added after this enum was written.
        // A value missing here is written and then silently unusable:
        // adapterFor() returns null, the cache check fails, and the school
        // re-probes on every page load as if it had never resolved.
        "ical",
        "wptribe",
        "drupal",
        "campusgroups",
        "moderncampus",
        "presence",
        "ems",
        // Not a platform: the school publishes no feed at all, and its events
        // were read off its own events page by a scheduled offline job. The
        // feed URL below is that page, and it is also the key into
        // CampusScrapedEvents. Never written by a probe.
        "scraped",
        "none"
      ],
      "default": "unknown"
    },
    "events_feed_url": {
      // Base URL for the platform above, enough to re-fetch without probing:
      //   localist    https://events.fairfield.edu/api/2/events
      //   livewhale   https://events.uconn.edu/live/json/events
      //   trumba      https://www.trumba.com/calendars/tufts.json
      //   campuslabs  https://nyu.campuslabs.com/engage/api/discovery/event/search
      //   campusgroups https://usf.campusgroups.com/mobile_ws/v17/mobile_events_list
      //   moderncampus https://api.calendar.moderncampus.net/pubcalendar/<uuid>/events
      //   presence    https://api.presence.io/sdsu/v1/events
      // Empty when events_platform is "none".
      "type": "string"
    },
    "events_resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    // ── Is that feed still working? ──
    // A resolved feed is cached forever and never looked at again, so a school
    // whose calendar moved, expired or emptied out goes on quietly serving
    // nothing. These three fields are the only way anyone finds out.
    //
    // Written on TRANSITION, not on every read: a feed that has been fine for a
    // week costs no writes, and one that just broke is stamped once. That keeps
    // this off the hot path of every student's page load.
    "events_last_ok_at": {
      // Last time a fetch of this feed came back with at least one real event.
      "type": "string",
      "format": "date-time"
    },
    "events_last_error": {
      // Empty means healthy. "Returned no upcoming events" counts as an error,
      // because a calendar with nothing on it is indistinguishable to a student
      // from one that is broken, and both need a human to look.
      "type": "string"
    },
    "events_last_error_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "canonical_name"
  ],
  // Same shape as Resources: reference data everyone may read, nobody but an
  // admin may change. Nothing here is private (school names, public logos,
  // public calendar URLs), so read stays open.
  //
  // The write side is the part that matters. events_feed_url is fetched
  // server-side by campusEvents and its contents are shown to every student at
  // that school, so an account able to edit this row could point our own server
  // at a URL of its choosing and feed the result to other people. With no rls
  // block at all that was open to any signed-in user.
  //
  // Locking writes costs nothing: every write to this entity runs through
  // asServiceRole in campusEvents, and asServiceRole acts *as* role admin
  // rather than bypassing rls, so it satisfies the condition below rather than
  // sidestepping it. No browser code touches the entity at all either. The
  // landing page marquee is a hardcoded list, not a read of this table.
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
