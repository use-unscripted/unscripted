{
  "name": "Missions",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "cycle_id": {
      "type": "string"
    },
    "legacy_review": {
      "type": "boolean",
      "default": false
    },
    "experiment_id": {
      "type": "string"
    },
    "path_id": {
      "type": "string"
    },
    "path_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "required_action": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outreach_required": {
      "type": "boolean",
      "default": false
    },
    "outreach_archetype": {
      "type": "string"
    },
    "outreach_purpose": {
      "type": "string"
    },
    "suggested_message": {
      "type": "string"
    },
    "questions_to_ask": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "in_progress",
        "completed",
        "skipped"
      ],
      "default": "planned"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "deadline": {
      "type": "string",
      "format": "date"
    },
    "estimated_hours": {
      "type": "number"
    },
    "proof_required": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "deletion_status": {
      "type": "string",
      "enum": [
        "active",
        "deleted",
        "permanently_deleted"
      ],
      "default": "active"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    },
    "purge_at": {
      "type": "string",
      "format": "date-time"
    },
    "deleted_by_user_id": {
      "type": "string"
    },
    "restored_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "experiment_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}