{
  "name": "StudentProfile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "education_stage": {
      "type": "string",
      "enum": [
        "high_school",
        "college"
      ],
      "default": "college"
    },
    "college": {
      "type": "string"
    },
    "major": {
      "type": "string"
    },
    "graduation_year": {
      "type": "string"
    },
    "school_year": {
      "type": "string"
    },
    "career_interests": {
      "type": "string"
    },
    "desired_lifestyle": {
      "type": "string"
    },
    "vision_themes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vision_timeframe": {
      "type": "string",
      "enum": [
        "five_years",
        "ten_years",
        "unsure"
      ]
    },
    "income_goals": {
      "type": "string"
    },
    "location_preferences": {
      "type": "string"
    },
    "work_life_balance": {
      "type": "string"
    },
    "pressured_paths": {
      "type": "string"
    },
    "secret_paths": {
      "type": "string"
    },
    "people_admired": {
      "type": "string"
    },
    "favorite_topics": {
      "type": "string"
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "current_skills": {
      "type": "string"
    },
    "desired_skills": {
      "type": "string"
    },
    "commitments": {
      "type": "string"
    },
    "biggest_blocker": {
      "type": "string"
    },
    "thirty_day_success": {
      "type": "string"
    },
    "available_hours_per_week": {
      "type": "number"
    },
    "financial_priorities": {
      "type": "string"
    },
    "priority_autonomy": {
      "type": "number"
    },
    "priority_stability": {
      "type": "number"
    },
    "priority_impact": {
      "type": "number"
    },
    "priority_creativity": {
      "type": "number"
    },
    "priority_ownership": {
      "type": "number"
    },
    "willing_financial_risk": {
      "type": "boolean"
    },
    "willing_long_hours": {
      "type": "boolean"
    },
    "willing_to_relocate": {
      "type": "boolean"
    },
    "class_schedule": {
      "type": "string"
    },
    "high_energy_times": {
      "type": "string"
    },
    "low_energy_times": {
      "type": "string"
    },
    "guest_session_id": {
      "type": "string"
    },
    "personal_notes": {
      "type": "string"
    },
    "long_term_ambitions": {
      "type": "string"
    },
    "responsibilities_constraints": {
      "type": "string"
    },
    "things_to_avoid": {
      "type": "string"
    },
    "priorities_for_recommendations": {
      "type": "string"
    },
    "onboarding_version": {
      "type": "number"
    },
    "baseline_career_clarity": {
      "type": "number"
    },
    "baseline_confidence": {
      "type": "number"
    },
    "baseline_recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "current_decision_pressure": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "current_decision_pressure_note": {
      "type": "string"
    },
    "current_careers_considered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "careers_ruled_out": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "major_uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "major_uncertainties_other": {
      "type": "string"
    },
    "self_reported_energizers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "self_reported_drains": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "activity": {
            "type": "string"
          },
          "response": {
            "type": "string",
            "enum": [
              "like",
              "neutral",
              "unsure",
              "dislike",
              "never_experienced"
            ]
          }
        }
      }
    },
    "values_importance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "factor": {
            "type": "string"
          },
          "importance": {
            "type": "number"
          }
        }
      }
    },
    "work_setting_preference": {
      "type": "string",
      "enum": [
        "remote",
        "hybrid",
        "in_person",
        "unsure"
      ]
    },
    "prior_experiences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "enjoyed": {
            "type": "string"
          },
          "disliked": {
            "type": "string"
          },
          "learned": {
            "type": "string"
          },
          "again": {
            "type": "string",
            "enum": [
              "yes",
              "maybe",
              "no"
            ]
          }
        }
      }
    },
    "uncertainty_updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}