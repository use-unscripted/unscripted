{
  "name": "NetworkReport",
  "type": "object",
  "properties": {
    "reporter_user_id": {
      "type": "string"
    },
    "reported_user_id": {
      "type": "string"
    },
    "report_type": {
      "type": "string",
      "enum": [
        "profile",
        "proof",
        "path"
      ]
    },
    "related_record_id": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "inappropriate",
        "spam",
        "misleading",
        "harassment",
        "other"
      ]
    },
    "explanation": {
      "type": "string"
    },
    "moderation_status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "actioned",
        "dismissed"
      ],
      "default": "pending"
    }
  },
  "required": [
    "reporter_user_id",
    "reported_user_id",
    "report_type",
    "reason"
  ]
}