{
  "name": "MissionGuides",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "path_id": {
      "type": "string"
    },
    "experiment_id": {
      "type": "string"
    },
    "mission_id": {
      "type": "string"
    },
    "guide_title": {
      "type": "string"
    },
    "version_number": {
      "type": "number"
    },
    "idempotency_key": {
      "type": "string"
    },
    "generation_prompt_context": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "deliverable": {
      "type": "string"
    },
    "proof_requirement": {
      "type": "string"
    },
    "reflection_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimated_time": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "inactive",
        "completed",
        "deleted"
      ],
      "default": "draft"
    },
    "is_active": {
      "type": "boolean",
      "default": false
    },
    "deletion_status": {
      "type": "string",
      "enum": [
        "active",
        "deleted",
        "permanently_deleted"
      ],
      "default": "active"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    },
    "purge_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "experiment_id",
    "guide_title",
    "version_number"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}