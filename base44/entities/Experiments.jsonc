{
  "name": "Experiments",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "cycle_id": {
      "type": "string"
    },
    "career_cycle_id": {
      "type": "string"
    },
    "legacy_review": {
      "type": "boolean",
      "default": false
    },
    "path_name": {
      "type": "string"
    },
    "path_id": {
      "type": "string"
    },
    "path_recommendation_id": {
      "type": "string"
    },
    "career_hypothesis_id": {
      "type": "string"
    },
    "career_name": {
      "type": "string"
    },
    "unresolved_question": {
      "type": "string"
    },
    "unresolved_question_id": {
      "type": "string"
    },
    "uncertainty_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty_label": {
      "type": "string"
    },
    "decision_dimension_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test_question": {
      "type": "string"
    },
    "why_this_test_matters": {
      "type": "string"
    },
    "predicted_enjoyment": {
      "type": "number"
    },
    "predicted_difficulty": {
      "type": "number"
    },
    "predicted_interest": {
      "type": "number"
    },
    "predicted_energy": {
      "type": "number"
    },
    "predicted_concerns": {
      "type": "string"
    },
    "predictions_recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "post_experiment_results": {
      "type": "object"
    },
    "effort": {
      "type": "string",
      "enum": [
        "15-30 minutes",
        "30-45 minutes",
        "1 hour",
        "2-3 hours",
        "several days",
        "1 week",
        "multi-week"
      ]
    },
    "work_characteristics_tested": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "work_characteristic_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "difficulty_level": {
      "type": "string",
      "enum": [
        "introductory",
        "moderate",
        "challenging"
      ]
    },
    "realistic_scenario": {
      "type": "string"
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evaluation_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_expected": {
      "type": "string"
    },
    "evidence_purpose": {
      "type": "string"
    },
    "design_source": {
      "type": "string",
      "enum": [
        "hypothesis_designed",
        "custom",
        "legacy"
      ]
    },
    "title": {
      "type": "string"
    },
    "experiment_type": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "expected_learning": {
      "type": "string"
    },
    "estimated_hours": {
      "type": "number"
    },
    "prerequisites": {
      "type": "string"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cost_estimate": {
      "type": "string"
    },
    "deliverable": {
      "type": "string"
    },
    "completion_criteria": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "deadline": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "planned",
        "in_progress",
        "completed",
        "skipped",
        "paused"
      ],
      "default": "draft"
    },
    "mission_guide_status": {
      "type": "string",
      "enum": [
        "not_generated",
        "generating",
        "generated"
      ],
      "default": "not_generated"
    },
    "mission_steps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "reflection_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proof_required": {
      "type": "string"
    },
    "common_mistakes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alternative_version": {
      "type": "string"
    },
    "paused_at": {
      "type": "string",
      "format": "date-time"
    },
    "pause_reason": {
      "type": "string"
    },
    "resumed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from_status": {
            "type": "string"
          },
          "to_status": {
            "type": "string"
          },
          "changed_at": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "deletion_status": {
      "type": "string",
      "enum": [
        "active",
        "deleted",
        "permanently_deleted"
      ],
      "default": "active"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    },
    "purge_at": {
      "type": "string",
      "format": "date-time"
    },
    "deleted_by_user_id": {
      "type": "string"
    },
    "restored_at": {
      "type": "string",
      "format": "date-time"
    },
    "status_before_deletion": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "objective"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}