{
  "name": "Experiments",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "path_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "expected_learning": {
      "type": "string"
    },
    "estimated_hours": {
      "type": "number"
    },
    "prerequisites": {
      "type": "string"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cost_estimate": {
      "type": "string"
    },
    "deliverable": {
      "type": "string"
    },
    "completion_criteria": {
      "type": "string"
    },
    "deadline": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "in_progress",
        "completed",
        "skipped"
      ],
      "default": "planned"
    },
    "mission_steps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "reflection_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proof_required": {
      "type": "string"
    },
    "common_mistakes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alternative_version": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "objective"
  ]
}