{
  "name": "WeeklyReflections",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "cycle_id": {
      "type": "string"
    },
    "legacy_review": {
      "type": "boolean",
      "default": false
    },
    "experiment_id": {
      "type": "string"
    },
    "mission_id": {
      "type": "string"
    },
    "path_id": {
      "type": "string"
    },
    "path_name": {
      "type": "string"
    },
    "week_start": {
      "type": "string",
      "format": "date"
    },
    "completed_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "avoided_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "avoidance_reasons": {
      "type": "string"
    },
    "energy_sources": {
      "type": "string"
    },
    "energy_drains": {
      "type": "string"
    },
    "surprises": {
      "type": "string"
    },
    "path_feedback": {
      "type": "string"
    },
    "skill_gaps_noticed": {
      "type": "string"
    },
    "lessons": {
      "type": "string"
    },
    "next_changes": {
      "type": "string"
    },
    "generated_summary": {
      "type": "string"
    },
    "path_adjustments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deletion_status": {
      "type": "string",
      "enum": [
        "active",
        "deleted",
        "permanently_deleted"
      ],
      "default": "active"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    },
    "purge_at": {
      "type": "string",
      "format": "date-time"
    },
    "deleted_by_user_id": {
      "type": "string"
    },
    "restored_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "week_start"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}