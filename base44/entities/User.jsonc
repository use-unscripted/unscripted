{
  "name": "User",
  "type": "object",
  "properties": {
    "college": {
      "type": "string"
    },
    "major": {
      "type": "string"
    },
    "graduation_year": {
      "type": "string"
    },
    "school_year": {
      "type": "string"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "access_source": {
      "type": "string",
      "enum": [
        "independent_beta",
        "institution_sponsored",
        "internal_admin"
      ],
      "default": "independent_beta"
    },
    "institution_id": {
      "type": "string"
    },
    "cohort_id": {
      "type": "string"
    },
    "sponsored_start": {
      "type": "string",
      "format": "date"
    },
    "sponsored_end": {
      "type": "string",
      "format": "date"
    }
  }
}