{
  "name": "User",
  "type": "object",
  "properties": {
    "college": {
      "type": "string"
    },
    "major": {
      "type": "string"
    },
    "graduation_year": {
      "type": "string"
    },
    "school_year": {
      "type": "string"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "access_source": {
      "type": "string",
      "enum": [
        "independent_beta",
        "institution_sponsored",
        "internal_admin"
      ],
      "default": "independent_beta",
      "rls": {
        "read": true,
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "analytics_class": {
      "type": "string",
      "enum": [
        "unclassified",
        "real_beta_user",
        "founder",
        "admin",
        "internal_test",
        "automated_test_agent"
      ],
      "default": "unclassified",
      "rls": {
        "read": true,
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "analytics_class_note": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "analytics_classified_at": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "institution_id": {
      "type": "string"
    },
    "cohort_id": {
      "type": "string"
    },
    "sponsored_start": {
      "type": "string",
      "format": "date"
    },
    "sponsored_end": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "college",
    "major",
    "graduation_year",
    "school_year",
    "institution_id",
    "cohort_id",
    "sponsored_start",
    "sponsored_end"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}