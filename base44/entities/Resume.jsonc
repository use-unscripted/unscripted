{
  "name": "Resume",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "resume_name": {
      "type": "string"
    },
    "template_id": {
      "type": "string"
    },
    "target_role": {
      "type": "string"
    },
    "target_path_id": {
      "type": "string"
    },
    "content": {
      "type": "object"
    },
    "section_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "resume_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}