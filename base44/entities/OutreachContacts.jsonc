{
  "name": "OutreachContacts",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "experiment_id": {
      "type": "string"
    },
    "mission_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "profile_url": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "contact_type": {
      "type": "string",
      "enum": [
        "informational_interview",
        "networking",
        "mentor",
        "recruiter",
        "alumni",
        "industry_professional",
        "founder",
        "investor",
        "potential_customer",
        "potential_partner",
        "other"
      ],
      "default": "networking"
    },
    "reason_for_contact": {
      "type": "string"
    },
    "date_contacted": {
      "type": "string",
      "format": "date"
    },
    "last_contacted_date": {
      "type": "string",
      "format": "date"
    },
    "followup_date": {
      "type": "string",
      "format": "date"
    },
    "response_status": {
      "type": "string",
      "enum": [
        "not_sent",
        "sent",
        "responded",
        "no_response",
        "call_scheduled",
        "completed",
        "follow_up_needed",
        "planning",
        "closed",
        "other"
      ],
      "default": "not_sent"
    },
    "call_scheduled": {
      "type": "boolean",
      "default": false
    },
    "call_date": {
      "type": "string"
    },
    "thank_you_sent": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "path_being_tested": {
      "type": "string"
    },
    "deletion_status": {
      "type": "string",
      "enum": [
        "active",
        "deleted",
        "permanently_deleted"
      ],
      "default": "active"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    },
    "purge_at": {
      "type": "string",
      "format": "date-time"
    },
    "deleted_by_user_id": {
      "type": "string"
    },
    "restored_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}