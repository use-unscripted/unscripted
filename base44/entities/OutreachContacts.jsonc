{
  "name": "OutreachContacts",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "cycle_id": {
      "type": "string"
    },
    "legacy_review": {
      "type": "boolean",
      "default": false
    },
    "experiment_id": {
      "type": "string"
    },
    "mission_id": {
      "type": "string"
    },
    "path_id": {
      "type": "string"
    },
    "path_name": {
      "type": "string"
    },
    "uncertainty_id": {
      "type": "string"
    },
    "uncertainty_label": {
      "type": "string"
    },
    "topic_id": {
      "type": "string"
    },
    "topic_label": {
      "type": "string"
    },
    "decision_dimension_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dedupe_key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "archetype": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "profile_url": {
      "type": "string"
    },
    "profile_verified": {
      "type": "boolean",
      "default": false
    },
    "other_contact_method": {
      "type": "string"
    },
    "search_url": {
      "type": "string"
    },
    "suggested_message": {
      "type": "string"
    },
    "outreach_format": {
      "type": "string",
      "enum": [
        "linkedin",
        "email",
        "alumni_network",
        "in_person",
        "other"
      ],
      "default": "linkedin"
    },
    "questions_to_ask": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "website_url": {
      "type": "string"
    },
    "how_known": {
      "type": "string",
      "enum": [
        "own_connection",
        "alumni",
        "mentor",
        "professor",
        "university_professional",
        "unscripted_professional",
        "event_or_panel",
        "cold_outreach",
        "other"
      ]
    },
    "contact_type": {
      "type": "string",
      "enum": [
        "informational_interview",
        "networking",
        "mentor",
        "recruiter",
        "alumni",
        "industry_professional",
        "founder",
        "investor",
        "potential_customer",
        "potential_partner",
        "other"
      ],
      "default": "networking"
    },
    "outreach_status": {
      "type": "string",
      "enum": [
        "identified",
        "outreach_drafted",
        "contacted",
        "responded",
        "conversation_scheduled",
        "conversation_completed",
        "no_response",
        "archived"
      ],
      "default": "identified"
    },
    "reason_for_contact": {
      "type": "string"
    },
    "date_contacted": {
      "type": "string",
      "format": "date"
    },
    "last_contacted_date": {
      "type": "string",
      "format": "date"
    },
    "followup_date": {
      "type": "string",
      "format": "date"
    },
    "response_status": {
      "type": "string",
      "enum": [
        "not_sent",
        "sent",
        "responded",
        "no_response",
        "call_scheduled",
        "completed",
        "follow_up_needed",
        "planning",
        "closed",
        "other"
      ],
      "default": "not_sent"
    },
    "call_scheduled": {
      "type": "boolean",
      "default": false
    },
    "call_date": {
      "type": "string"
    },
    "thank_you_sent": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "path_being_tested": {
      "type": "string"
    },
    "deletion_status": {
      "type": "string",
      "enum": [
        "active",
        "deleted",
        "permanently_deleted"
      ],
      "default": "active"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    },
    "purge_at": {
      "type": "string",
      "format": "date-time"
    },
    "deleted_by_user_id": {
      "type": "string"
    },
    "restored_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}