{
  "name": "AiFailure",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "feature": {
      "type": "string",
      "enum": [
        "path_generation",
        "mission_guide",
        "mission_guide_prefilled",
        "outreach_plan",
        "risk_assessment",
        "blueprint",
        "create_path",
        "reactivation",
        "resume_bullet",
        "weekly_reflection",
        "campus_event_ranking",
        "language_transform",
        "glossary_term",
        "work_sim_review"
      ]
    },
    "stage": {
      "type": "string"
    },
    "codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attempts": {
      "type": "number"
    },
    "recovered": {
      "type": "boolean"
    },
    "model": {
      "type": "string"
    },
    "path_id": {
      "type": "string"
    },
    "experiment_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed": {
      "type": "boolean",
      "default": false
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_by": {
      "type": "string"
    }
  },
  "required": [
    "feature"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}