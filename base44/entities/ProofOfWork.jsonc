{
  "name": "ProofOfWork",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "cycle_id": {
      "type": "string"
    },
    "legacy_review": {
      "type": "boolean",
      "default": false
    },
    "experiment_id": {
      "type": "string"
    },
    "mission_id": {
      "type": "string"
    },
    "path_id": {
      "type": "string"
    },
    "submission_key": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "report",
        "model",
        "case_study",
        "article",
        "post",
        "newsletter",
        "video",
        "podcast",
        "prototype",
        "landing_page",
        "service_pilot",
        "interview_notes",
        "simulation",
        "presentation",
        "database",
        "community",
        "volunteer",
        "screenshot",
        "spreadsheet",
        "written_summary",
        "other"
      ]
    },
    "path_tested": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "skills_demonstrated": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "external_url": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "file_size": {
      "type": "number"
    },
    "mime_type": {
      "type": "string"
    },
    "completion_note": {
      "type": "string"
    },
    "outcome": {
      "type": "string"
    },
    "feedback": {
      "type": "string"
    },
    "reflection": {
      "type": "string"
    },
    "hypothesis_interpretation": {
      "type": "string"
    },
    "interpretation_direction": {
      "type": "string",
      "enum": [
        "supports",
        "weakens",
        "mixed",
        "unclear"
      ]
    },
    "interpreted_test_question": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "public"
      ],
      "default": "private"
    },
    "network_visibility": {
      "type": "string",
      "enum": [
        "private",
        "followers",
        "my_university",
        "all_unscripted"
      ],
      "default": "private"
    },
    "network_shared_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date"
    },
    "resume_status": {
      "type": "string",
      "enum": [
        "not_reviewed",
        "approved",
        "excluded"
      ],
      "default": "not_reviewed"
    },
    "approved_title": {
      "type": "string"
    },
    "approved_deliverable": {
      "type": "string"
    },
    "approved_bullet": {
      "type": "string"
    },
    "approved_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved_link": {
      "type": "string"
    },
    "resume_reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "resume_imported_at": {
      "type": "string",
      "format": "date-time"
    },
    "deletion_status": {
      "type": "string",
      "enum": [
        "active",
        "deleted",
        "permanently_deleted"
      ],
      "default": "active"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    },
    "purge_at": {
      "type": "string",
      "format": "date-time"
    },
    "deleted_by_user_id": {
      "type": "string"
    },
    "restored_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "category"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}