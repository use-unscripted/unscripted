{
  "name": "CampusInvite",
  "type": "object",
  "properties": {
    "inviter_user_id": {
      "type": "string"
    },
    "inviter_university_name": {
      "type": "string"
    },
    "token": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "revoked": {
      "type": "boolean",
      "default": false
    },
    "max_uses": {
      "type": "number",
      "default": 50
    },
    "use_count": {
      "type": "number",
      "default": 0
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claimed_user_id": {
            "type": "string"
          },
          "claimed_at": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "inviter_user_id",
    "token"
  ],
  // Creator-scoped on all four verbs. `read` and `update` were both null, which
  // made every invite world-readable and — the one that mattered — world-writable:
  // any logged-in student could revoke someone else's invite, push out its
  // expiry, or raise max_uses. Nothing in the app reads or writes this entity
  // today (no invite flow exists), so scoping it costs nothing.
  //
  // If a claim flow is ever built, the claimant is not the creator and so will
  // not be able to read the invite by token under these rules. That case needs a
  // backend function that genuinely bypasses RLS — not a loosened `read` here.
  //
  // Be careful which mechanism you reach for: `created_by_id` scoping is enforced
  // even for role admin (measured 2026-08-03 — an admin account read 1 of 72
  // StudentProfiles and 4 of 225 Experiments), and `asServiceRole` acts *as* admin
  // rather than bypassing the rules. So neither an admin token nor `asServiceRole`
  // is sufficient on its own to look an invite up by token.
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}