{
  "name": "PathRecommendations",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "path_id": {
      "type": "string"
    },
    "path_name": {
      "type": "string"
    },
    "path_category": {
      "type": "string"
    },
    "fit_reason": {
      "type": "string"
    },
    "concern": {
      "type": "string"
    },
    "readiness_score": {
      "type": "number"
    },
    "confidence_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "current_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "first_experiment": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "paused",
        "completed",
        "archived",
        "exploring",
        "deprioritized"
      ],
      "default": "exploring"
    },
    "is_primary_focus": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string"
    },
    "why_it_fits": {
      "type": "string"
    },
    "why_it_may_not_fit": {
      "type": "string"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "lifestyle_implications": {
      "type": "string"
    },
    "skill_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "weekly_hours": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "goals": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date"
    },
    "last_active_at": {
      "type": "string",
      "format": "date"
    },
    "paused_at": {
      "type": "string",
      "format": "date"
    },
    "completed_at": {
      "type": "string",
      "format": "date"
    },
    "path_fit_signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_detail": {
      "type": "object"
    },
    "network_visibility": {
      "type": "string",
      "enum": [
        "private",
        "followers",
        "my_university",
        "all_unscripted"
      ],
      "default": "private"
    },
    "network_summary": {
      "type": "string"
    },
    "network_shared_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "path_name",
    "fit_reason"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}