{
  "name": "PathRecommendations",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "onboarding_submission_id": {
      "type": "string"
    },
    "path_set_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "generation_status": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete",
        "needs_review",
        "manual"
      ]
    },
    "is_sample": {
      "type": "boolean"
    },
    "path_id": {
      "type": "string"
    },
    "path_name": {
      "type": "string"
    },
    "path_category": {
      "type": "string"
    },
    "fit_reason": {
      "type": "string"
    },
    "concern": {
      "type": "string"
    },
    "readiness_score": {
      "type": "number"
    },
    "confidence_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "confidence_explanation": {
      "type": "string"
    },
    "current_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "first_experiment": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "paused",
        "completed",
        "archived",
        "exploring",
        "deprioritized"
      ],
      "default": "exploring"
    },
    "is_primary_focus": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string"
    },
    "why_it_fits": {
      "type": "string"
    },
    "why_it_may_not_fit": {
      "type": "string"
    },
    "main_tradeoffs": {
      "type": "string"
    },
    "goals_supported": {
      "type": "string"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "lifestyle_implications": {
      "type": "string"
    },
    "skill_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "weekly_hours": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "goals": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date"
    },
    "last_active_at": {
      "type": "string",
      "format": "date"
    },
    "paused_at": {
      "type": "string",
      "format": "date"
    },
    "completed_at": {
      "type": "string",
      "format": "date"
    },
    "path_fit_signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_detail": {
      "type": "object"
    },
    "network_visibility": {
      "type": "string",
      "enum": [
        "private",
        "followers",
        "my_university",
        "all_unscripted"
      ],
      "default": "private"
    },
    "network_summary": {
      "type": "string"
    },
    "network_shared_at": {
      "type": "string",
      "format": "date-time"
    },
    "career_fit_score": {
      "type": "number"
    },
    "fit_confidence_score": {
      "type": "number"
    },
    "why_this_may_fit": {
      "type": "string"
    },
    "supporting_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "contradicting_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "why_it_matters": {
            "type": "string"
          }
        }
      }
    },
    "hypothesis_status": {
      "type": "string",
      "enum": [
        "suggested",
        "testing",
        "strong_evidence",
        "mixed_evidence",
        "low_fit",
        "archived"
      ],
      "default": "suggested"
    },
    "last_recalculated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "path_name",
    "fit_reason"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}