{
  "name": "BlockedUser",
  "type": "object",
  "properties": {
    "blocker_user_id": {
      "type": "string"
    },
    "blocked_user_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "blocker_user_id",
    "blocked_user_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.blocker_user_id": "{{user.id}}"
        },
        {
          "data.blocked_user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}